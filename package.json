{
  "name": "tweakroot",
  "version": "0.0.3",
  "description": "tweak a taproot pubkey using elliptic curve operations",
  "type": "module",
  "main": "lib/tweakroot.js",
  "bin": {
    "tweakroot-cli": "./bin/tweakroot-cli.js"
  },
  "scripts": {
